{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parallel text",
  "type": "object",
  "required": ["source_language", "target_language", "source_text", "target_text"],
  "additionalProperties": false,
  "properties": {
    "source_language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"},
    "target_language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"},
    "source_text": {"type": "string", "minLength": 1},
    "target_text": {"type": "string", "minLength": 1},
    "domain": {"type": "string"},
    "dialect_note": {"type": "string"}
  }
}
