{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exam question",
  "type": "object",
  "required": ["exam_name", "subject", "year", "question_text"],
  "additionalProperties": false,
  "properties": {
    "exam_name": {"type": "string", "description": "For example GCE Ordinary Level, Probatoire, a named concours."},
    "exam_body": {"type": "string"},
    "subject": {"type": "string"},
    "year": {"type": "integer", "minimum": 1950, "maximum": 2100},
    "session": {"type": "string"},
    "paper": {"type": "string"},
    "question_number": {"type": "string"},
    "question_text": {"type": "string", "minLength": 3},
    "question_format": {"type": "string", "enum": ["multiple_choice", "short_answer", "essay", "problem_solving", "practical", "true_false", "fill_in", "other"]},
    "options": {"type": "array", "items": {"type": "string"}},
    "answer": {"type": "string"},
    "answer_explanation": {"type": "string"},
    "marks": {"type": "number", "minimum": 0},
    "topics": {"type": "array", "items": {"type": "string"}},
    "figure_file": {"type": "string", "description": "Relative path to an image if the question depends on a diagram."}
  }
}
